{
  "name": "ims",
  "version": "1.0.0",
  "description": "Simple Inventory Management System",
  "homepage": "https://github.com/cezaryzelisko/ims#readme",
  "bugs": {
    "url": "https://github.com/cezaryzelisko/ims/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cezaryzelisko/ims.git"
  },
  "license": "ISC",
  "author": "Cezary Żelisko",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "start:local": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typeorm": "npx typeorm-ts-node-commonjs",
    "typeorm:create": "npm run typeorm -- migration:create",
    "typeorm:generate": "npm run typeorm -- migration:generate -d src/unit-of-work/connectors/postgres-db/data-source.ts",
    "typeorm:revert": "npm run typeorm -- migration:revert -d src/unit-of-work/connectors/postgres-db/data-source.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-request-id": "^3.0.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
